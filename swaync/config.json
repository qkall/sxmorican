{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "positionX": "center",
  "positionY": "bottom",
  "layer": "overlay",
  "control-center-width": 475,
  "control-center-height": 600,
  "notification-window-width": 400,
  "keyboard-shortcuts": true,
  "image-visibility": "when-available",
  "transition-time": 200,
  "hide-on-clear": true,
  "hide-on-action": true,
  "ignore-gtk-theme": true,
  "widgets": [
    "title",
    "dnd",
    "mpris",
    "notifications",
  	"volume",
    "backlight"
  ],
  "widget-config": {
    "backlight": {
      "device": "ae94000.dsi.0",
      "min": 5,
      "label": "󰃞"
    },
    "volume": {
      "label": "󰕾"
    },
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear All"
    },
    "dnd": {
      "text": "Do Not Disturb"
    },
    "notifications": {
      "vexpand": true
    }
  }
}
